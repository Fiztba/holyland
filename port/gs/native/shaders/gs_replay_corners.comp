#version 450
#extension GL_GOOGLE_include_directive : require
// --frame-rate's pictures between drawn on the GPU (port/gs/native/gsn.cpp, "Pictures between on the
// GPU"): each corner of each triangle the frame's packets drew, made of the vertex kicks it came of at
// the picture's time (gs_replay.comp moved them), as the GS makes its triangles' corners (make_vtx,
// add_triangle, add_sprite, snap_sprite_uv, flat_2d), into the vertices gs.vert draws (gsn.cpp's Vtx):
// the recorded draws are the GS's own, only their vertices come from here.
#include "gs_replay.h"

layout(local_size_x = 64) in;

// how each kick moves (gsn.h, GsnInterpMove): a triangle's last kick's two before it with a place
layout(set = 1, binding = 2, std430) readonly buffer Moves {
    uint moves[];
};
layout(set = 1, binding = 3, std430) readonly buffer Resolved {
    uint resolved[];
};
// the corners: how many, then each as its kicks (a triangle's three, a sprite's two) and how (IC_*)
layout(set = 1, binding = 4, std430) readonly buffer Corners {
    uvec4 corner_count;
    uvec4 corners[];
};
// the vertices drawn (gsn.cpp's Vtx: X, Y, Z, RGBA, S, T, Q, fog), 8 words each
layout(set = 1, binding = 5, std430) writeonly buffer Vertices {
    uint vertices[];
};

uint R(uint k, uint i) {
    return resolved[k * 8u + i];
}

// A corner as gs.vert takes it (gsn.cpp's Vtx)
struct V {
    vec2 pos;
    uint z;
    uint rgba;
    vec3 stq;
    float fog;
};

// gsn.cpp's make_vtx: X and Y less XYOFFSET (offset: X | Y << 16)
vec2 place(uint xy, uint offset) {
    return vec2(float(int(xy & 0xFFFFu) - int(offset & 0xFFFFu)), float(int(xy >> 16) - int(offset >> 16))) / 16.0;
}

vec3 stq_of(uint k, bool fst) {
    if (fst) {
        uint uv = R(k, 6u);
        return vec3(float(uv & 0x3FFFu) / 16.0, float((uv >> 16) & 0x3FFFu) / 16.0, uintBitsToFloat(R(k, 5u)));
    }
    return vec3(uintBitsToFloat(R(k, 3u)), uintBitsToFloat(R(k, 4u)), uintBitsToFloat(R(k, 5u)));
}

bool dropped(uint k) {
    return k < pic.counts.x && (R(k, 7u) & (RK_PROC | RK_DROP)) == (RK_PROC | RK_DROP);
}

// gsn.cpp's flat_2d: a rectangle of one colour and Z, its corners out to the edges of the GS pixels it
// covers (o: the corner wanted, of v0, v1, v2)
void flat_2d(V v0, V v1, V v2, inout V o) {
    if (v0.z != v1.z || v0.z != v2.z || v0.rgba != v1.rgba || v0.rgba != v2.rgba) {
        return;
    }
    float x0 = min(v0.pos.x, min(v1.pos.x, v2.pos.x)), x1 = max(v0.pos.x, max(v1.pos.x, v2.pos.x));
    float y0 = min(v0.pos.y, min(v1.pos.y, v2.pos.y)), y1 = max(v0.pos.y, max(v1.pos.y, v2.pos.y));
    if (!(x0 < x1 && y0 < y1)) {
        return;
    }
    bvec2 c0 = bvec2(v0.pos.x == x0 || v0.pos.x == x1, v0.pos.y == y0 || v0.pos.y == y1);
    bvec2 c1 = bvec2(v1.pos.x == x0 || v1.pos.x == x1, v1.pos.y == y0 || v1.pos.y == y1);
    bvec2 c2 = bvec2(v2.pos.x == x0 || v2.pos.x == x1, v2.pos.y == y0 || v2.pos.y == y1);
    if (!(all(c0) && all(c1) && all(c2))) {
        return;
    }
    float ax = v1.pos.x - v0.pos.x, ay = v1.pos.y - v0.pos.y;
    float bx = v2.pos.x - v0.pos.x, by = v2.pos.y - v0.pos.y;
    float det = ax * by - bx * ay;
    if (det == 0.0) {
        return;
    }
    vec4 a0 = vec4(v0.stq, v0.fog);
    vec4 da = vec4(v1.stq, v1.fog) - a0, db = vec4(v2.stq, v2.fog) - a0;
    vec4 dx = (da * by - db * ay) / det, dy = (db * ax - da * bx) / det;
    vec2 n = ceil(o.pos) - 0.5;
    vec4 a = vec4(o.stq, o.fog) + dx * (n.x - o.pos.x) + dy * (n.y - o.pos.y);
    o.stq = a.xyz;
    o.fog = a.w;
    o.pos = n;
}

V sprite_corner(uint i, uint xya, uint xyb, uint offset, vec3 sa, vec3 sb, uint z, uint rgba, float fog) {
    // (corner 0 a's X and Y, 1 b's X a's Y, 2 a's X b's Y, 3 b's)
    bool ax = i == 0u || i == 2u, ay = i < 2u;
    V c;
    c.pos = place(((ax ? xya : xyb) & 0xFFFFu) | ((ay ? xya : xyb) & 0xFFFF0000u), offset);
    c.z = z;
    c.rgba = rgba;
    c.stq = vec3(ax ? sa.x : sb.x, ay ? sa.y : sb.y, sb.z);
    c.fog = fog;
    return c;
}

V triangle_corner(uint k, uint colour, bool fst) {
    V v;
    v.pos = place(R(k, 0u), kicks[k * 16u + 8u]);
    v.z = R(k, 1u);
    v.rgba = R(colour, 2u);
    v.stq = stq_of(k, fst);
    v.fog = float(kicks[k * 16u + 7u]);
    return v;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= corner_count.x) {
        return;
    }
    uvec4 a_corner = corners[i];
    uint info = a_corner.w;
    bool fst = (info & IC_FST) != 0u;
    V v0, v1, v2, v;
    bool gone = false;
    if (a_corner.x >= pic.counts.x || a_corner.y >= pic.counts.x || ((info & IC_SPRITE) == 0u && a_corner.z >= pic.counts.x)) {
        gone = true; // (never: every kick is the frame's)
        v.pos = vec2(0.0);
        v.z = 0u;
        v.rgba = 0u;
        v.stq = vec3(0.0);
        v.fog = 0.0;
    } else if ((info & IC_SPRITE) != 0u) {
        // gsn.cpp's add_sprite: colour, Z, Q and fog the second kick's; X, Y, S, T (U, V) corner to corner;
        // XYOFFSET the second's
        uint ka = a_corner.x, kb = a_corner.y;
        uint offset = kicks[kb * 16u + 8u];
        uint xya = R(ka, 0u), xyb = R(kb, 0u);
        vec3 sa = stq_of(ka, fst), sb = stq_of(kb, fst);
        if ((info & IC_SNAP) != 0u) {
            // gsn.cpp's snap_sprite_uv
            ivec2 pa = ivec2(int(xya & 0xFFFFu) - int(offset & 0xFFFFu), int(xya >> 16) - int(offset >> 16));
            ivec2 pb = ivec2(int(xyb & 0xFFFFu) - int(offset & 0xFFFFu), int(xyb >> 16) - int(offset >> 16));
            ivec2 d0 = ivec2(round(sa.xy * 16.0)) - pa, d1 = ivec2(round(sb.xy * 16.0)) - pb;
            ivec2 mn = min(d0, d1), mx = max(d0, d1);
            ivec2 dist = abs(pb - pa);
            bvec2 npot = notEqual(dist & (dist - 1), ivec2(0));
            bvec2 centre = equal(mn & 15, ivec2(8));
            bvec2 next = bvec2(((mx.x & 15) == 9) && npot.x, ((mx.y & 15) == 9) && npot.y);
            bool snapped = (centre.x || next.x) && (centre.y || next.y) && mx.x - mn.x <= 1 && mx.y - mn.y <= 1;
            if (snapped) {
                ivec2 lo = (mn & ~15) | 8;
                sa.xy = vec2(pa + lo) / 16.0;
                sb.xy = vec2(pb + lo) / 16.0;
            }
        }
        uint z = R(kb, 1u), rgba = R(kb, 2u);
        float fog = float(kicks[kb * 16u + 7u]);
        // its triangle: corners 0, 1, 2, or 1, 3, 2
        uint corner = info & 3u;
        bool second = (info & 4u) != 0u;
        v0 = sprite_corner(second ? 1u : 0u, xya, xyb, offset, sa, sb, z, rgba, fog);
        v1 = sprite_corner(second ? 3u : 1u, xya, xyb, offset, sa, sb, z, rgba, fog);
        v2 = sprite_corner(2u, xya, xyb, offset, sa, sb, z, rgba, fog);
        v = sprite_corner(corner, xya, xyb, offset, sa, sb, z, rgba, fog);
    } else {
        // gsn.cpp's add_triangle, of the kicks queued (each made at its own kick): flat shading the third's colour
        uvec3 k = a_corner.xyz;
        bool flat_shade = (info & IC_FLAT_SHADE) != 0u;
        v0 = triangle_corner(k.x, flat_shade ? k.z : k.x, fst);
        v1 = triangle_corner(k.y, flat_shade ? k.z : k.y, fst);
        v2 = triangle_corner(k.z, k.z, fst);
        uint own = info & 3u;
        v = own == 0u ? v0 : own == 1u ? v1 : v2;
        // a triangle a picture between drops (the ADC frame_interp.c gives a vertex dropped and the two
        // after it): its kick dropped, or one of the two before it with a place
        uint last = R(k.z, 7u);
        if ((last & RK_PROC) != 0u &&
            ((last & RK_DROP) != 0u || dropped(moves[k.z * 16u + 2u]) || dropped(moves[k.z * 16u + 3u]))) {
            gone = true;
        }
    }
    if (!gone && (info & IC_FLAT_2D) != 0u) {
        flat_2d(v0, v1, v2, v);
    }
    if (gone) {
        // (far past the target's right edge, as are its two other corners: the triangle is not drawn)
        v.pos = vec2(1.0e9, 1.0e9);
    }
    uint at = i * 8u;
    vertices[at + 0u] = floatBitsToUint(v.pos.x);
    vertices[at + 1u] = floatBitsToUint(v.pos.y);
    vertices[at + 2u] = v.z;
    vertices[at + 3u] = v.rgba;
    vertices[at + 4u] = floatBitsToUint(v.stq.x);
    vertices[at + 5u] = floatBitsToUint(v.stq.y);
    vertices[at + 6u] = floatBitsToUint(v.stq.z);
    vertices[at + 7u] = floatBitsToUint(v.fog);
}
