execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "Expected assertion exit 1, got ${result}: ${output} ${error}")
endif()
string(FIND "${error}" "${EXPECTED}" match)
if(match LESS 0)
    message(FATAL_ERROR "Expected ${EXPECTED}, got ${output} ${error}")
endif()
message(STATUS "Detected intended corruption: ${error}")
