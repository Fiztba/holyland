+                    st.pend_max = max(st.pend_max, t + FMAC_LATENCY)
+                elif sp in (0x2F, 0x30):
+                    pass
+                else:
+                    raise LiftError(f"0x{p.pc:04x}: upper special {sp:#x} not supported")
+            if p.is_fmac_flag_op():
+                st.pend_max = max(st.pend_max, t + FMAC_LATENCY)
+            if commit is not None and commit[0] == 0:
+                commit = None   # writes to VF00 are discarded
+            if commit is not None and commit[1] == 0:
+                commit = None
+    
+            out += self.lower_sem(p, st, t)
+    
+            if commit is not None:
+                target, d = commit
+                reg = "acc" if target == "acc" else vf(target)
+                if d == 0xF:
+                    out.append(f"    {reg} = {up};")
+                else:
+                    out.append(f"    {reg} = vl::blend<0x{blend_imm(d):x}>({reg}, {up});")
+            if p.ibit:
+                out.append(f"    I = {fbits(normalize_bits(p.lower))};")
+            return out
+
+    def lower_sem(self, p, st, t):
+            out = []
+            w = p.lower
+            k = p.lower_kind()
+            dest = (w >> 21) & 0xF
+            vft, vfs = (w >> 16) & 31, (w >> 11) & 31
+            vit, vis, vid = (w >> 16) & 15, (w >> 11) & 15, (w >> 6) & 15
+            imm11 = s11(w)
+            drop_vf = p.suppressed_lower_vf  # upper writes the same VF: lower's write is lost
+            for r in (vit, vis, vid):
+                if r:
+                    self.vi_used.add(r)
+    
+            def wvf(reg, expr):
+                if reg == 0 or reg == drop_vf or dest == 0:
+                    return
+                self.vf_used.add(reg)
+                if dest == 0xF:
+                    out.append(f"    {vf(reg)} = {expr};")
+                else:
+                    out.append(f"    {vf(reg)} = vl::blend<0x{blend_imm(dest):x}>({vf(reg)}, {expr});")
+    
+            def wvi(reg, expr):
+                if reg:
+                    out.append(f"    {vi(reg)} = {expr};")
+    
+            def store_cycle():
+                return f"T + {t}" if st.kick else "0"
+    
+            if k in ("nop", "loi", "waitq", "waitp"):
+                return out
+            if k == "lq":
+                wvf(vft, f"vl::lq(mem, {vi(vis)} + {imm11})")
+            elif k == "sq":
+                self.vf_used.add(vfs)
+                if dest:
+                    out.append(f"    vl::sq<0x{blend_imm(dest):x}, {str(st.kick).lower()}>(c, mem, {vi(vit)} + {imm11}, {vf(vfs)}, {store_cycle()});")
+                st.pend_max = max(st.pend_max, t + 1)
+            elif k == "ilw":
+                comp = next((c for c in range(4) if dest & lane(c)), 3)
+                wvi(vit, f"vl::ilw(mem, {vi(vis)} + {imm11}, {comp})")
+            elif k == "isw":
+                if dest:
+                    out.append(f"    vl::isw<0x{blend_imm(dest):x}, {str(st.kick).lower()}>(c, mem, {vi(vis)} + {imm11}, {vi(vit)}, {store_cycle()});")
+                st.pend_max = max(st.pend_max, t + 1)
+            elif k in ("iaddiu", "isubiu"):
+                imm = (w & 0x7FF) | ((w >> 10) & 0x7800)
+                wvi(vit, f"vl::i16({vi(vis)} {'+' if k == 'iaddiu' else '-'} {imm})")
+            elif k in ("iadd", "isub"):
+                wvi(vid, f"vl::i16({vi(vis)} {'+' if k == 'iadd' else '-'} {vi(vit)})")
+            elif k == "iaddi":
+                imm5 = ((w >> 6) & 0x1F)
+                imm5 = imm5 - 32 if imm5 & 0x10 else imm5
+                wvi(vit, f"vl::i16({vi(vis)} + {imm5})")
+            elif k == "iand":
+                wvi(vid, f"{vi(vis)} & {vi(vit)}")
+            elif k == "ior":
+                wvi(vid, f"{vi(vis)} | {vi(vit)}")
+            elif k == "fcand":
+                self.vi_used.add(1)
+                out.append(f"    vi01 = (clip & 0x{w & 0xFFFFFF:06x}u) != 0u ? 1 : 0;")
+            elif k == "fceq":
+                self.vi_used.add(1)
+                out.append(f"    vi01 = (clip & 0xFFFFFFu) == 0x{w & 0xFFFFFF:06x}u ? 1 : 0;")
+            elif k == "fcor":
+                self.vi_used.add(1)
+                out.append(f"    vi01 = ((clip | 0x{w & 0xFFFFFF:06x}u) & 0xFFFFFFu) == 0xFFFFFFu ? 1 : 0;")
+            elif k == "fcget":
+                wvi(vit, "static_cast<int32_t>(clip & 0x0FFFu)")
+            elif k == "fcset":
+                # queueFcset; a CLIP issued in the same cycle loses its clip write.
+                if p.uu.writes_clip:
+                    raise LiftError(f"0x{p.pc:04x}: CLIP and FCSET in one pair")
+                n = len(st.clip)
+                out.append(f"    clipW = 0x{w & 0xFFFFFF:06x}u; clipPend{n} = clipW;")
+                self.uses.add(f"clipPend{n}")
+                st.clip.append(t + FMAC_LATENCY)
+                st.pend_max = max(st.pend_max, t + FMAC_LATENCY)
+            elif k in ("b", "ibeq", "ibne", "ibltz", "ibgtz", "iblez", "ibgez"):
+                def br(r):
+                    if r == 0:
+                        return "0"
+                    return "viBk" if st.bk_reg == r else f"vl::i16({vi(r)})"
+                cond = {"b": "true",
+                        "ibeq": f"{br(vis)} == {br(vit)}", "ibne": f"{br(vis)} != {br(vit)}",
+                        "ibltz": f"{br(vis)} < 0", "ibgtz": f"{br(vis)} > 0",
+                        "iblez": f"{br(vis)} <= 0", "ibgez": f"{br(vis)} >= 0"}[k]
+                if k != "b":
+                    out.append(f"    const bool taken_{p.pc:04x} = {cond};")
+            elif k in ("lqi", "lqd"):
+                if k == "lqd":
+                    wvi(vis, f"vl::i16({vi(vis)} - 1)")
+                wvf(vft, f"vl::lq(mem, vl::u16({vi(vis)}))")
+                if k == "lqi":
+                    wvi(vis, f"vl::i16({vi(vis)} + 1)")
+            elif k in ("sqi", "sqd"):
+                self.vf_used.add(vfs)
+                if k == "sqd":
+                    wvi(vit, f"vl::i16({vi(vit)} - 1)")
+                if dest:
+                    out.append(f"    vl::sq<0x{blend_imm(dest):x}, {str(st.kick).lower()}>(c, mem, vl::u16({vi(vit)}), {vf(vfs)}, {store_cycle()});")
+                if k == "sqi":
+                    wvi(vit, f"vl::i16({vi(vit)} + 1)")
+                st.pend_max = max(st.pend_max, t + 1)
+            elif k == "div":
+                fsf, ftf = (w >> 21) & 3, (w >> 23) & 3
+                self.vf_used.update(r for r in (vfs, vft) if r)
+                out.append(f"    qPend = vl::div(vl::lane<{fsf}>({vf(vfs)}), vl::lane<{ftf}>({vf(vft)}), diPend);")
+                st.fdiv = t + 7
+                st.pend_max = max(st.pend_max, t + 7)
+            elif k == "mtir":
+                comp = (w >> 21) & 3
+                self.vf_used.add(vfs)
+                wvi(vit, f"vl::i16(static_cast<int32_t>(vl::bits<{comp}>({vf(vfs)})))")
+            elif k == "mfir":
+                wvf(vft, f"vl::splatBits(vl::i16({vi(vis)}))")
+            elif k == "move":
+                self.vf_used.add(vfs)
+                wvf(vft, vf(vfs))
+            elif k == "mr32":
+                self.vf_used.add(vfs)
+                wvf(vft, f"vl::mr32({vf(vfs)})")
+            elif k == "mfp":
+                wvf(vft, "vl::splat(p)")
+            elif k == "xtop":
+                wvi(vit, "static_cast<int32_t>(top & 0x3FFu)")
+            elif k == "xitop":
+                wvi(vit, "static_cast<int32_t>(itop & 0x3FFu)")
+            elif k == "xgkick":
+                out.append(f"    vl::kickStart(c, vl::u16({vi(vis)}), T + {t});")
+                st.kick = True
+            elif k == "efu":
+                sp = (w & 3) | ((w >> 4) & 0x7C)
+                if sp != 0x70:
+                    raise LiftError(f"0x{p.pc:04x}: EFU op {sp:#x} not supported yet")
+                self.vf_used.add(vfs)
+                n = len(st.efu)
+                if n >= 2:
+                    raise LiftError(f"0x{p.pc:04x}: more than two EFU results pending")
+                out.append(f"    pPend{n} = vl::esadd({vf(vfs)});")
+                lat = EFU_LATENCY[sp]
+                st.efu.append(t + lat)
+                st.efu_res = t + lat - 1
+                out.append(f"    efuReady = T + {t + lat - 1};")
+                st.pend_max = max(st.pend_max, t + lat)
+            else:
+                raise LiftError(f"0x{p.pc:04x}: lower op {k} not supported")
+            if p.first_vi_write and p.lu.delays_branch:
+                # A branch in the next pair reads the pre-write value (readBranchVi).
+                r = p.first_vi_write
+                out.insert(0, f"    viBk = vl::i16({vi(r)});")
+            return out
diff --git a/ps2xRuntime/tools/vu_bounded_loop.h.in b/ps2xRuntime/tools/vu_bounded_loop.h.in
new file mode 100644
index 0000000..b56078f
--- /dev/null
+++ b/ps2xRuntime/tools/vu_bounded_loop.h.in
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstdint>
+#include "runtime/ps2_vu1.h"
+
+namespace vu_bounded {
+struct FmacFlags { uint32_t mac = 0, status = 0, extraSticky = 0; };
+struct StatusTransform {
+    uint32_t andMask = 0xffffffffu, orBits = 0;
+    void then(uint32_t mask, uint32_t bits) { andMask &= mask; orBits = (orBits & mask) | bits; }
+    uint32_t apply(uint32_t value) const { return (value & andMask) | orBits; }
+};
+// The adapter first admits a catalog match, uninterrupted full interval,
+// complete incoming readiness, and exclusive memory ownership. At startCycle:
+// no active XGKICK/branch/stop, no pending Q/store. Up to four incoming flag
+// entries, ordered by (readyCycle, canonical queue slot), must mature by S+3.
+// One incoming P is permitted if it matures by the generated limit; incoming
+// EFU resource readiness must fit the generated first-EFU issue deadline.
+struct IncomingFlag {
+    uint64_t readyCycle = 0;
+    uint32_t mac = 0, statusAndMask = 0xffffffffu, statusOrBits = 0, clip = 0;
+    bool writesMac = false, writesClip = false;
+};
+struct Entry {
+    uint64_t startCycle = 0, budgetEnd = 0, efuResourceReady = 0, incomingPReady = 0;
+    uint32_t workingClip = 0, incomingFlagCount = 0;
+    std::array<IncomingFlag,4> incomingFlags{};
+    float incomingP = 0;
+    bool hasIncomingP = false;
+    uint32_t maxIterations = UINT32_MAX;
+};
+struct Readiness { uint8_t slot; uint16_t cycleOffset; };
+struct PendingFlag {
+    uint16_t cycleOffset = 0;
+    uint32_t mac = 0, statusAndMask = 0xffffffffu, statusOrBits = 0, clip = 0;
+    bool writesMac = false, writesStatus = false, writesClip = false;
+};
+struct Tail {
+    uint64_t endCycle = 0, writebackHorizon = 0;
+    uint64_t finalStartCycle = 0;
+    uint32_t iterations = 0;
+    StatusTransform completedStatus;
+    std::array<PendingFlag,8> flags{};
+    uint32_t flagCount = 0, workingClip = 0;
+    float pendingQ = 0;
+    uint32_t qStatusDi = 0;
+    uint16_t qReadyOffset = 0;
+    bool hasPendingQ = false, branchTaken = false, viBackupValid = false;
+    uint8_t viBackupRegister = 0;
+    int32_t viBackupValue = 0;
+    struct Scalar { uint16_t cycleOffset = 0; float value = 0; };
+    std::array<Scalar,2> pEvents{};
+    uint32_t pCount = 0;
+    uint64_t efuResourceReady = 0;
+};
+using Kernel = bool (*)(VU1State*, uint8_t*, uint32_t, const Entry*, Tail*);
+struct Region {
+    uint32_t head, branchPc, fallthrough;
+    uint16_t pairCount, cycles, writebackOffset;
+    const Readiness *incomingReads; uint32_t incomingReadCount;
+    const Readiness *finalWrites; uint32_t finalWriteCount;
+    Kernel execute;
+    uint16_t incomingPLimitOffset, firstEfuIssueOffset;
+    bool hasEfu;
+    uint16_t repeatInterval;
+    bool canRepeat;
+};
+// No entry means canonical fallback. Generated input words remain private.
+extern const Region regions[];
+extern const uint32_t regionCount;
+}
diff --git a/ps2xRuntime/tools/vu_bounded_loops.py b/ps2xRuntime/tools/vu_bounded_loops.py
new file mode 100644
index 0000000..fe32a3a
--- /dev/null
+++ b/ps2xRuntime/tools/vu_bounded_loops.py
@@ -0,0 +1,441 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Discover closed conditional-backedge VU loops and emit bounded kernels.
+
+Input bytes and all generated files are private. This reusable source contains
+no game addresses, instructions, hashes or gameplay constants. Unsupported
+instructions, control flow and scalar pipelines decline to canonical fallback.
+Instruction expressions come from the narrow GPL vu_bounded_expressions
+module; the canonical decoder and event validator gate every emitted region.
+"""
+import hashlib
+import json
+from pathlib import Path
+import re
+import vu_bounded_math as canonical_math
+import vu_bounded_expressions as expressions
+
+CONDITIONAL = {'ibeq', 'ibne', 'ibltz', 'ibgtz', 'iblez', 'ibgez'}
+LOWER_SUPPORTED = CONDITIONAL | {
+    'nop', 'loi', 'lq', 'sq', 'ilw', 'isw', 'lqi', 'lqd', 'sqi', 'sqd',
+    'iadd', 'isub', 'iaddi', 'iaddiu', 'isubiu', 'iand', 'ior', 'mtir',
+    'move', 'mfir', 'mr32', 'fcand', 'fceq', 'fcor', 'fcget', 'div', 'mfp', 'efu'}
+PIPELINES = {None: 0, 'fmac': 1, 'lsu': 2, 'fdiv': 3, 'efu': 4, 'ialu': 5, 'branch': 6, 'xgkick': 7}
+
+
+def plan_region(lift, image, block):
+    """No incoming writes; runtime guards their exact first read deadlines."""
+    ready, first, written = {}, {}, set()
+    now = fdiv_ready = writeback = efu_resource = 0
+    first_efu = None
+    rows, events = [], []
+    for pair in block:
+        issue = max([now] + [ready.get(s, 0) for s in pair.read_slots])
+        kind = pair.lower_kind()
+        if kind == 'div': issue = max(issue, fdiv_ready)
+        if kind == 'efu': issue = max(issue, efu_resource)
+        for slot in pair.read_slots:
+            if slot not in written: first.setdefault(slot, issue)
+        for slot, latency in pair.writes:
+            ready[slot] = issue + latency
+            writeback = max(writeback, issue + latency)
+            written.add(slot)
+        if pair.is_fmac_flag_op(): events.append(dict(kind='fmac', pc=pair.pc, issue=issue, ready=issue+4))
+        if pair.uu.writes_clip: events.append(dict(kind='clip', pc=pair.pc, issue=issue, ready=issue+4))
+        if kind == 'div':
+            fdiv_ready = issue + 7
+            events.append(dict(kind='q', pc=pair.pc, issue=issue, ready=fdiv_ready))
+        if kind == 'efu':
+            if first_efu is None: first_efu = issue
+            efu_resource = issue + pair.lu.latency - 1
+            events.append(dict(kind='p', pc=pair.pc, issue=issue, ready=issue+pair.lu.latency))
+        rows.append(dict(pair=pair, issue=issue))
+        now = issue + 1
+    pending = [e for e in events if e['ready'] > now]
+    if sum(e['kind'] in ('fmac','clip') for e in pending) > 8 or sum(e['kind'] == 'q' for e in pending) > 1 or sum(e['kind'] == 'p' for e in pending)>2:
+        raise ValueError('Unsupported pending tail capacity')
+    if now > 65535 or max(ready.values(), default=now) > 65535:
+        raise ValueError('Timing metadata overflow')
+    return dict(rows=rows, events=events, cycles=now, incoming=first, final=ready,
+        writeback=writeback, head=block[0].pc, first_efu=first_efu, efu_resource=efu_resource,
+        incoming_p_limit=min(now,first_efu+1) if first_efu is not None else now,
+        branch=block[-2].pc, fallthrough=(block[-1].pc+8) & (len(image)-1))
+
+
+def plan_repeat(plan):
+    """Prove the complete canonical second schedule is a translated first.
+
+    The first next issue is derived from the actual head dependencies. Waiting
+    until an unrelated later-use deadline would move stalls and is forbidden.
+    """
+    ready=dict(plan['final'])
+    end=plan['cycles']; fdiv=max((e['ready'] for e in plan['events'] if e['kind']=='q'),default=0)
+    efu=plan['efu_resource']; start=None; stable=True
+    for row in plan['rows']:
+        p=row['pair'];kind=p.lower_kind()
+        issue=max([end]+[ready.get(s,0) for s in p.read_slots])
+        if kind=='div':issue=max(issue,fdiv)
+        if kind=='efu':issue=max(issue,efu)
+        if start is None:start=issue
+        if issue!=start+row['issue']:stable=False
+        for s,latency in p.writes:ready[s]=issue+latency
+        if kind=='div':fdiv=issue+7
+        if kind=='efu':efu=issue+p.lu.latency-1
+        end=issue+1
+    pending=[e for e in plan['events'] if e['ready']>plan['cycles']]
+    flags=[e for e in pending if e['kind'] in ('fmac','clip')]
+    ps=[e for e in pending if e['kind']=='p']
+    reason=None
+    if not stable:reason='nonstationary backedge schedule'
+    elif any(e['kind']=='q' for e in pending):reason='pending Q backedge'
+    elif len(flags)>4 or any(e['ready']>start+3 for e in flags):reason='deep backedge flag tail'
+    elif len(ps)>1 or any(e['ready']>start+plan['incoming_p_limit'] for e in ps):reason='deep backedge P tail'
+    elif plan['first_efu'] is not None and plan['efu_resource']>start+plan['first_efu']:reason='backedge EFU resource'
+    plan.update(repeat_interval=start,can_repeat=reason is None,repeat_refusal=reason)
+
+
+def writes_vf0(pair):
+    """Preserve the interpreter's transient upper VF0 write semantics.
+
+    Canonical upper execution can write VF0 until the pair ends, so lower
+    reads in that pair can observe the temporary value. Its dependency
+    descriptor intentionally omits VF0 writes. The local expression emitter
+    assumes a constant VF0; conservatively keep all such writers canonical.
+    ACC-target arithmetic, CLIP and NOP are not VF destination writes.
+    """
+    if ((pair.upper >> 21) & 15) == 0:
+        return False
+    op = pair.upper & 63
+    if op <= 0x2f:
+        return ((pair.upper >> 6) & 31) == 0
+    if pair.upper_sp() in (*range(0x10, 0x18), 0x1d):
+        return ((pair.upper >> 16) & 31) == 0
+    return False
+
+
+def discover(lift, image, min_pairs=8, max_pairs=64):
+    pairs, rejected = {}, []
+    for pc in range(0, len(image), 8):
+        try: pairs[pc] = lift.PairInfo(image, pc)
+        except lift.LiftError: pass
+    result = []
+    for pc, branch in pairs.items():
+        if branch.lower_kind() not in CONDITIONAL: continue
+        head = branch.branch_target()
+        count = (pc-head)//8 + 2
+        if not (head < pc and min_pairs <= count <= max_pairs and pc+8 < len(image)): continue
+        reason = None
+        block = [pairs.get(at) for at in range(head, pc+16, 8)]
+        if any(p is None for p in block): reason = 'reserved instruction'
+        elif any(p.is_branch() for p in block[:-2]) or block[-1].is_branch(): reason = 'internal/delay branch'
+        elif any(p.ebit or p.dbit or p.tbit for p in block): reason = 'termination/interrupt bit'
+        elif any(p.lower_kind() not in LOWER_SUPPORTED for p in block): reason = 'unsupported lower/scalar pipeline'
+        elif any(writes_vf0(p) for p in block): reason = 'transient upper VF0 write'
+        if reason:
+            rejected.append(dict(head=head, branch=pc, reason=reason)); continue
+        try:
+            # Probe exactly the semantics emitter used for output. In particular,
+            # unsupported upper ops are rejected rather than guessed.
+            emitter, state = lift.Emitter(image, head), lift.TState()
+            plan = plan_region(lift, image, block)
+            plan_repeat(plan)
+            for row in plan['rows']:
+                p = row['pair']
+                state.efu = [] # this generator owns pending capacity/timing
+                emitter.semantics(p, state, row['issue'])
+                state.bk_reg = p.first_vi_write if p.lu.delays_branch else 0
+            result.append(plan)
+        except (lift.LiftError, ValueError, KeyError) as error:
+            rejected.append(dict(head=head, branch=pc, reason=str(error)))
+    return result, rejected
+
+
+def pending_payload(event, ordinal):
+    pc, ready = event['pc'], event['ready']
+    target = f'tail.flags[{ordinal}]'
+    lines = [f'    {target}.cycleOffset = {ready}u;']
+    if event['kind'] == 'fmac':
+        name = f'flag_{pc:x}'
+        lines += [f'    {target}.mac = {name}.mac; {target}.statusAndMask = 0xff0u;',
+            f'    {target}.statusOrBits = {name}.status | (({name}.status | {name}.extraSticky) << 6u);',
+            f'    {target}.writesMac = true; {target}.writesStatus = true;']
+    else:
+        lines += [f'    {target}.clip = clip_{pc:x}; {target}.writesClip = true;']
+    return lines
+
+
+def emit_region(lift, image, plan, ordinal):
+    emitter, state = lift.Emitter(image, plan['head']), lift.TState()
+    ordered_events = sorted(plan['events'], key=lambda e:(e['ready'], {'fmac':0,'clip':0,'q':1,'p':2}[e['kind']], e['issue']))
+    clips = [e for e in ordered_events if e['kind']=='clip']
+    q_events = [e for e in ordered_events if e['kind']=='q']
+    p_events = [e for e in ordered_events if e['kind']=='p']
+    flag_events = [e for e in ordered_events if e['kind']=='fmac']
+    body, consumed = [], set()
+
+    def incoming_clip_at(time):
+        return [f'    while (incomingClipIndex<incomingFlagCount && incomingFlags[incomingClipIndex].readyCycle <= iterationStart+{time}u) {{',
+                '        const auto &event=incomingFlags[incomingClipIndex++]; if(event.writesClip)clip=event.clip;', '    }']
+
+    def incoming_p_at(time):
+        return [f'    if (incomingPPending && incomingPReady<=iterationStart+{time}u) {{',
+                '        p=incomingP; incomingPPending=false;', '    }']
+
+    def commits(time):
+        lines = []
+        for index,e in enumerate(ordered_events):
+            if index in consumed or e['ready']>time: continue
+            consumed.add(index)
+            if e['kind']=='clip':
+                lines.extend(incoming_clip_at(e['ready']))
+                lines.append(f"    clip = clip_{e['pc']:x};")
+            elif e['kind']=='q': lines.append(f"    q = q_{e['pc']:x};")
+            elif e['kind']=='p':
+                lines.extend(incoming_p_at(e['ready']))
+                lines.append(f"    p = p_{e['pc']:x};")
+        return lines
+
+    for row in plan['rows']:
+        p, issue = row['pair'], row['issue']
+        body += commits(issue)
+        if p.lu.reads_clip: body += incoming_clip_at(issue)
+        if p.lower_kind()=='mfp': body += incoming_p_at(issue)
+        body += ['    // ' + p.dis.line()]
+        clip_index = len(state.clip)
+        state.efu=[]
+        emitted = '\n'.join(emitter.semantics(p, state, issue)).replace('vl::', 'kg::')
+        if p.is_fmac_flag_op(): emitted = emitted.replace(', fl);', f', flag_{p.pc:x});')
+        if p.uu.writes_clip: emitted = emitted.replace(f'clipPend{clip_index}', f'clip_{p.pc:x}')
+        if p.lower_kind()=='div': emitted = emitted.replace('qPend',f'q_{p.pc:x}').replace('diPend',f'di_{p.pc:x}')
+        if p.lower_kind()=='efu':
+            emitted = emitted.replace('pPend0',f'p_{p.pc:x}')
+            emitted = re.sub(r'    efuReady = T \+ \d+;\n?', '', emitted)
+        # Keep full pre-write VI payload; branch comparisons still cast to VI16.
+        emitted = re.sub(r'viBk = kg::i16\((vi\d+)\);', r'viBk = \1;', emitted)
+        if p.is_branch():
+            emitted = emitted.replace('viBk', 'kg::i16(viBk)')
+            emitted = emitted.replace('const bool taken_', 'taken_')
+        body.append(emitted)
+        state.bk_reg = p.first_vi_write if p.lu.delays_branch else 0
+    body += commits(plan['cycles'])
+    body += incoming_clip_at(plan['cycles'])
+    body += incoming_p_at(plan['cycles'])
+
+    declarations = [f'    kg::V vf{r:02d} = kg::load(st.vf[{r}]);' for r in sorted(emitter.vf_used)]
+    declarations += [f'    int32_t vi{r:02d} = st.vi[{r}];' for r in sorted(emitter.vi_used)]
