+        + product + '\n}\n')
+    helpers = (Path(__file__).parent / 'vu_bounded_numeric.inc').read_text()
+    # Preserve the actual ESADD expression and evaluation order, then perform
+    # the normalization queueP applies before publishing the scalar value.
+    esadd=lower[lower.index('            case 0x70: // ESADD'):lower.index('            case 0x71: // ERSADD')]
+    esadd=esadd[esadd.index('{')+1:esadd.rindex('}')]
+    esadd=replace_once(esadd,'                return;\n','')
+    for lane in range(3):esadd=replace_once(esadd,f'm_state.vf[vfS][{lane}]',f'lane<{lane}>(value)')
+    esadd=esadd.replace('normalizeOperand(', 'normf(')
+    esadd=replace_once(esadd,'queueP(x * x + y * y + z * z, 11u);',
+        'ExactContext context; uint32_t ignored=0; return context.normalizeResult(x * x + y * y + z * z,ignored);')
+    esadd='\nnamespace kg { inline float esadd(V value) {\n'+esadd+'\n} }\n'
+    return prefix + context + methods + '\n}\n' + fast + helpers + esadd
