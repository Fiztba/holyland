+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Extract current canonical pure numerical helpers with checked rewrites."""
+from pathlib import Path
+
+
+def function(text, anchor):
+    if text.count(anchor) != 1:
+        raise ValueError('Canonical source anchor changed: ' + anchor)
+    begin = text.index(anchor)
+    return text[begin:text.index('\n}\n', begin) + 3]
+
+
+def replace_once(text, old, new):
+    if text.count(old) != 1:
+        raise ValueError('Canonical numerical rewrite changed: ' + old)
+    return text.replace(old, new)
+
+
