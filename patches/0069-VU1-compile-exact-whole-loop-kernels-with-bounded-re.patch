+def emit(runtime, image, header_name):
+    if len(image)!=16384: raise ValueError('VU1 requires an explicit 16KiB input image')
+    lift = expressions
+    plans,rejected = discover(lift,image)
+    header = Path(__file__).with_name('vu_bounded_loop.h.in').read_text()
+    source = f'''// Generated from explicit input bytes. Keep output private.
