+// SPDX-License-Identifier: GPL-3.0-or-later
+// Private pure numeric helpers. FMAC normalization is the extracted canonical
+// normalizeFmacResult above; there is no use of the owner's older vl::fmac.
+namespace kg {
+using V = __m128;
+using vu_bounded::FmacFlags;
+using vu_bounded::Entry;
+constexpr FmacLaneOp Add = FmacLaneOp::Add, Sub = FmacLaneOp::Sub,
+    Mul = FmacLaneOp::Mul, MAdd = FmacLaneOp::MAdd, MSub = FmacLaneOp::MSub;
+inline const V kVf0 = _mm_setr_ps(0, 0, 0, 1);
+inline const V kZero = _mm_setzero_ps();
+inline V load(const float *p) { return _mm_loadu_ps(p); }
+inline void store(float *p, V v) { _mm_storeu_ps(p, v); }
+inline V norm(V v) {
+    // The SSE2 arm of canonical normalizeOperands, with register I/O.
+    const __m128i bits = _mm_castps_si128(v);
+    const __m128i exponent = _mm_and_si128(bits, _mm_set1_epi32(0x7F800000));
+    const __m128i sign = _mm_and_si128(bits, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+    const __m128i zeroExponent = _mm_cmpeq_epi32(exponent, _mm_setzero_si128());
+    __m128i normalized = _mm_or_si128(_mm_andnot_si128(zeroExponent, bits), _mm_and_si128(zeroExponent, sign));
+    const __m128i specialExponent = _mm_cmpeq_epi32(exponent, _mm_set1_epi32(0x7F800000));
+    const __m128i saturated = _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF));
+    return _mm_castsi128_ps(_mm_or_si128(_mm_andnot_si128(specialExponent, normalized), _mm_and_si128(specialExponent, saturated)));
+}
+inline float normf(float v) {
+    uint32_t b = std::bit_cast<uint32_t>(v), e = (b >> 23u) & 255u;
+    if (e == 0u) b &= 0x80000000u;
+    else if (e == 255u) b = (b & 0x80000000u) | 0x7f7fffffu;
+    return std::bit_cast<float>(b);
+}
+template<int C> inline V bc(V v) { return _mm_shuffle_ps(v, v, C * 0x55); }
+inline V splat(float v) { return _mm_set1_ps(v); }
+template<int C> inline float lane(V v) { return _mm_cvtss_f32(bc<C>(v)); }
+template<int C> inline uint32_t bits(V v) { return std::bit_cast<uint32_t>(lane<C>(v)); }
+inline int32_t i16(int32_t v) { return static_cast<int16_t>(v); }
+inline uint32_t u16(int32_t v) { return static_cast<uint16_t>(v); }
+inline float f32(uint32_t v) { return std::bit_cast<float>(v); }
+inline V splatBits(int32_t v) { return _mm_castsi128_ps(_mm_set1_epi32(v)); }
+inline V mr32(V v) { return _mm_shuffle_ps(v, v, _MM_SHUFFLE(0, 3, 2, 1)); }
+inline V vabs(V v) { return _mm_and_ps(v, _mm_castsi128_ps(_mm_set1_epi32(0x7fffffff))); }
+template<int Mask> inline V blend(V a, V b) {
+    const __m128 m = _mm_castsi128_ps(_mm_setr_epi32(
+        Mask & 1 ? -1 : 0, Mask & 2 ? -1 : 0, Mask & 4 ? -1 : 0, Mask & 8 ? -1 : 0));
+    return _mm_or_ps(_mm_andnot_ps(m, a), _mm_and_ps(m, b));
+}
+template<FmacLaneOp Op, int Dest> inline V fmac(V av, V bv, V cv, FmacFlags &flags) {
+    alignas(16) float a[4], b[4], c[4], r[4];
+    // Exactly the canonical SSE2 calculateFmacLanes operations. Keep multiply
+    // and add/sub separate; caller compiles with strict FP and no contraction.
+    V value;
+    if constexpr (Op == Add) value = _mm_add_ps(av, bv);
+    else if constexpr (Op == Sub) value = _mm_sub_ps(av, bv);
+    else if constexpr (Op == Mul) value = _mm_mul_ps(av, bv);
+    else if constexpr (Op == MAdd) value = _mm_add_ps(cv, _mm_mul_ps(av, bv));
+    else value = _mm_sub_ps(cv, _mm_mul_ps(av, bv));
+    store(r, value);
+#ifndef VU_BOUNDED_CANONICAL_ONLY
+    if constexpr (Op == MAdd || Op == MSub) {
+        if (classifyProduct(av, bv, r, Dest, flags)) return value;
+    } else {
+        if (classifyNormal(r, Dest, flags)) return value;
+    }
+#endif
+    store(a, av); store(b, bv); store(c, cv);
+    constexpr uint32_t code = Op == Add ? 0x28u : Op == Sub ? 0x2cu : Op == Mul ? 0x2au : Op == MAdd ? 0x29u : 0x2du;
+    ExactContext context;
+    context.m_currentUpperInstruction = code | (uint32_t(Dest) << 21u);
+    context.m_fmacVs = a; context.m_fmacVt = b; context.m_fmacAcc = c;
+    uint8_t lanes[4]{}; uint32_t sticky = 0;
+    context.normalizeFmacResult(r, Dest, lanes, sticky);
+    uint32_t mac = 0, status = 0;
+    for (uint32_t lane = 0; lane < 4u; ++lane) {
+        const uint32_t f = (Dest & (8u >> lane)) ? lanes[lane] : 0u;
+        mac |= uint32_t(kFmacFlagScatter[f & 15u]) << (3u - lane); status |= f;
+    }
+    flags = {mac, status, sticky};
+    return load(r);
+}
+inline V vmax(V a, V b) { return _mm_max_ps(a, b); }
+inline V vmin(V a, V b) { return _mm_min_ps(a, b); }
+template<int Shift> inline V itof(V a) {
+    V r = _mm_cvtepi32_ps(_mm_castps_si128(a));
+    if constexpr (Shift != 0) r = _mm_div_ps(r, splat(float(1u << Shift)));
+    return r;
+}
+template<int Shift, int Dest> inline V ftoi(V a) {
+    alignas(16) float v[4]; alignas(16) int32_t i[4]; store(v, a);
+    for (uint32_t lane = 0; lane < 4u; ++lane) i[lane] = vuFloatToInt(v[lane], float(1u << Shift));
+    return _mm_castsi128_ps(_mm_load_si128(reinterpret_cast<const __m128i *>(i)));
+}
+inline uint32_t clipFlags(V a, V b) {
+    const uint32_t w = bits<3>(b);
+    const int32_t limit = (w & 0x7f800000u) ? int32_t(w & 0x7fffffffu) : 0x007fffff;
+    alignas(16) uint32_t raw[4]; _mm_store_si128(reinterpret_cast<__m128i *>(raw), _mm_castps_si128(a));
+    uint32_t flags = 0;
+    for (uint32_t lane = 0; lane < 3u; ++lane) {
+        flags |= uint32_t(std::bit_cast<int32_t>(raw[lane]) > limit) << (lane * 2u);
+        flags |= uint32_t(std::bit_cast<int32_t>(raw[lane] ^ 0x80000000u) > limit) << (lane * 2u + 1u);
+    }
+    return flags;
+}
+inline float div(float a, float b, uint32_t &di) {
+    const float n = normf(a), d = normf(b); float r;
+    if (d == 0) { di = n == 0 ? 0x10u : 0x20u; r = std::signbit(n) != std::signbit(d) ? -std::numeric_limits<float>::max() : std::numeric_limits<float>::max(); }
+    else { di = 0; r = n / d; }
+    ExactContext context; uint32_t ignored = 0; return context.normalizeResult(r, ignored);
+}
+inline uint32_t qaddr(int32_t a) { return (uint32_t(a) * 16u) & 0x3fffu; }
+inline V lq(const uint8_t *mem, int32_t a) { return _mm_loadu_ps(reinterpret_cast<const float *>(mem + qaddr(a))); }
+inline int32_t ilw(const uint8_t *mem, int32_t a, int component) {
+    uint32_t v; std::memcpy(&v, mem + qaddr(a) + component * 4, 4); return int16_t(v & 0xffffu);
+}
+template<int Mask> inline void storeLanes(uint8_t *p, __m128i v) {
+    if constexpr (Mask == 15) _mm_storeu_si128(reinterpret_cast<__m128i *>(p), v);
+    else { alignas(16) uint32_t words[4]; _mm_store_si128(reinterpret_cast<__m128i *>(words), v);
+        for (uint32_t lane = 0; lane < 4; ++lane) if (Mask & (1u << lane)) std::memcpy(p + lane * 4, words + lane, 4); }
+}
+template<int Mask, bool Kick> inline void sq(const Entry &, uint8_t *mem, int32_t address, V v, uint64_t) {
+    static_assert(!Kick); storeLanes<Mask>(mem + qaddr(address), _mm_castps_si128(v));
+}
+template<int Mask, bool Kick> inline void isw(const Entry &, uint8_t *mem, int32_t address, int32_t value, uint64_t) {
+    static_assert(!Kick); storeLanes<Mask>(mem + qaddr(address), _mm_set1_epi32(uint16_t(value)));
+}
+}
