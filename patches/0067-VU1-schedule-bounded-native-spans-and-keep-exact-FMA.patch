From c812b0d105c271c3df499ca1060ecb7044a8290e Mon Sep 17 00:00:00 2001
From: Fizban <35464167+Fiztba@users.noreply.github.com>
Date: Sun, 11 Oct 2026 04:17:14 -0400
Subject: [PATCH] VU1: schedule bounded native spans and keep exact FMAC
 operands local

---
 ps2xRuntime/include/runtime/ps2_vu1.h   |   3 +
 ps2xRuntime/tools/generate_vu_native.py | 222 +++++++++++++++++++++++-
 2 files changed, 223 insertions(+), 2 deletions(-)

diff --git a/ps2xRuntime/include/runtime/ps2_vu1.h b/ps2xRuntime/include/runtime/ps2_vu1.h
index add2f9b..6788072 100644
--- a/ps2xRuntime/include/runtime/ps2_vu1.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1.h
@@ -348,6 +348,9 @@ private:
     int trySpecializedGroup(uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData,
                             uint32_t dataSize, GS &gs, PS2Memory *memory,
