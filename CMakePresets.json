{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows, clang (llvm-mingw or LLVM's clang)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang" }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux, gcc",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc" }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux, clang",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang" }
    }
  ],
  "buildPresets": [
    { "name": "windows-clang", "configurePreset": "windows-clang" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "configurePreset": "linux-clang" }
  ]
}
